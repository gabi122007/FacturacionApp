<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.facturacionapp.controller.CategoriaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Gestión de Categorías">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- Formulario -->
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
            </rowConstraints>
            <children>
                <Label text="Nombre:" />
                <TextField fx:id="txtNombre" promptText="Nombre de la categoría" GridPane.columnIndex="1" />

                <Label text="Estado:" GridPane.rowIndex="1" />
                <CheckBox fx:id="chkActivo" mnemonicParsing="false" selected="true" text="Activa" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>

        <!-- Botones de Acción -->
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" text="Guardar" />
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
                <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#cerrar" text="Cerrar" />
            </children>
        </HBox>

        <!-- Tabla de Categorías -->
        <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                <TableColumn fx:id="colActivo" prefWidth="80.0" text="Activo" />
            </columns>
        </TableView>
    </children>
</VBox>