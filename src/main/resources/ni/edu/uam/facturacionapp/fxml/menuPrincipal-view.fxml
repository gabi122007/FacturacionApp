<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacionapp.controller.MenuPrincipalController">
    <top>
        <VBox alignment="CENTER" prefHeight="80.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Sistema de Facturación" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="50.0" right="50.0" top="20.0" />
            </padding>
            <children>
            <ImageView fitHeight="178.0" fitWidth="168.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagenes/img.png" />
               </image></ImageView>
                <!-- Botón de Productos -->
                <Button mnemonicParsing="false" onAction="#abrirProductos" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #044570;" text="Gestión de Productos" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>

                <!-- Nuevo Botón de Categorías -->
                <Button mnemonicParsing="false" onAction="#abrirCategorias" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #320478;" text="Gestión de Categorías" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>

                <!-- Botón Salir -->
                <Button mnemonicParsing="false" onAction="#salir" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #1b1b3e;" text="Salir del Sistema" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>
